# ============================================================
# VARIABLES DE ENTORNO — Copia este archivo como .env
#   cp .env.example .env
# ============================================================
# Vite incrusta estas variables en tiempo de BUILD. Si cambias
# alguna, reinicia `npm run dev` o reconstruye la imagen.
# ============================================================

# ============================================================
# MODO MOCK — true = datos de prueba sin backend
#             false = conecta al backend real
# ============================================================
VITE_USE_MOCKS=false

# ============================================================
# BACKEND DE FRAMEWORK — Azure Container Apps (ambiente Dev)
# ============================================================

# Backend de chat. La base incluye /api/v1: de ahí cuelgan
# /sessions, /message, /attachment, /vote y /sema/*.
VITE_APP_API_URL_GPT=https://<container-app-name>.azurecontainerapps.io/api/v1

# Agente SQL — mismo backend cognitivo, pero aquí va SOLO el host
# (sin /api ni /api/v1): ApiSQL.ts agrega su propio "/api".
VITE_APP_API_URL_SQL=https://<container-app-name>.azurecontainerapps.io/api

# Catálogo de Unity Catalog por defecto para el chat SQL
VITE_CATALOG=sema_persistence

# ============================================================
# DESARROLLO LOCAL — descomenta si levantas el backend en tu máquina
# ============================================================
# VITE_APP_API_URL_GPT=http://localhost:8000/api/v1
# VITE_APP_API_URL_SQL=http://localhost:8001

# ============================================================
# AUTENTICACIÓN — Azure AD / MSAL
# ============================================================
# clientId y tenantId deben ser los mismos que usa el backend
# (AZURE_CLIENT_ID / AZURE_TENANT_ID en Key Vault), porque el backend
# valida audience = client_id. redirectUri debe incluir el esquema
# (http:// o https://), coincidir EXACTO (sin slash final de más/menos)
# con lo registrado en la App Registration, y coincidir con el origen
# real que sirve la app: si este .env se usa también para el build de
# Docker (producción), NO pongas aquí localhost — usa la URL del Web
# App desplegado, y crea .env.development.local (gitignored) con:
#   VITE_REDIRECT_URI=http://localhost:8501
# Vite lo carga automáticamente en `npm run dev`, sin tocar este archivo.
VITE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_REDIRECT_URI=http://localhost:8501
