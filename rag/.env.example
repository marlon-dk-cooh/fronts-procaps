# ============================================================
# VARIABLES DE ENTORNO — Copia este archivo como .env y completa
# ============================================================

# ============================================================
# MODO MOCK — true = datos de prueba sin backend
#             false = conecta al backend real
# ============================================================
VITE_USE_MOCKS=true

# URL del backend principal (chat GPT / RAG)
VITE_APP_API_URL_GPT=http://localhost:8000/api

# URL del backend del agente SQL
VITE_APP_API_URL_SQL=http://localhost:8001

# Catálogo por defecto para el agente SQL (opcional)
VITE_CATALOG=mi_catalogo

# ============================================================
# AUTENTICACIÓN — Descomenta según tu proveedor
# ============================================================

# --- Azure AD / MSAL ---
# VITE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# VITE_REDIRECT_URI=http://localhost:5173

# --- Auth0 ---
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com
# VITE_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Keycloak ---
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=mi-realm
# VITE_KEYCLOAK_CLIENT_ID=mi-cliente
